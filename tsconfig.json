{
    "compilerOptions": {
      "target": "ES6",
      "lib": ["dom", "esnext"],
      "jsx": "react-jsx",  // or "react" for older React versions
      "module": "esnext",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "allowSyntheticDefaultImports": true,
      "strict": true
    },
    "include": ["src"]
  }
  